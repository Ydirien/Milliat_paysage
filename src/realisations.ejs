      <figure class="project" data-reveal><%- images.img('taille-haie', { alt: 'Haie taillée de façon uniforme', sizes: portfolioSizes, loading: 'eager', fallbackWidth: 768, wide: true }) %><figcaption>Taille de haie<span>Mise au cordeau et évacuation des déchets de coupe</span></figcaption></figure>
      <figure class="project" data-reveal><%- images.img('jardin-arbore-apres-entretien', { alt: 'Jardin arboré après un passage d’entretien', sizes: portfolioSizes, fallbackWidth: 768, wide: true }) %><figcaption>Entretien d’un jardin arboré<span>Nettoyage des zones plantées et de la pelouse</span></figcaption></figure>
