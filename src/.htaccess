# Milliat Paysage, configuration Apache (o2switch)
# Prérequis : un certificat SSL valide pour milliatpaysage.fr et www.milliatpaysage.fr
# (cPanel > SSL/TLS Status > AutoSSL). Sans lui, la redirection HTTPS rend le site inaccessible.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType image/webp .webp

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Une seule adresse publique : https://milliatpaysage.fr
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://milliatpaysage.fr%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://milliatpaysage.fr%{REQUEST_URI} [L,R=301]

  # /index.html est servi uniquement sous /
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?]
  RewriteRule ^ / [L,R=301]

  # PHPMailer est inclus par send-mail.php et ne doit pas être accessible depuis le web
  RewriteRule ^vendor/ - [F,L]

  # Fichiers cachés et fichiers de projet, au cas où ils seraient déployés par erreur
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(md|log|lock|sh|ini|env|bak|sql|ya?ml|json|mjs|ejs)$ - [F,L]

  # Seul send-mail.php est un script exécutable
  RewriteCond %{REQUEST_URI} !^/send-mail\.php$
  RewriteRule \.php$ - [F,L]

  # Images de l'ancien site, encore présentes dans l'index Google Images
  RewriteRule ^assets/img/background\.png$ /assets/images/generated/jardin-entretenu-1024.webp [L,R=301]
  RewriteRule ^assets/img/conception-sur-mesure\.jpg$ /assets/images/generated/amenagement-paysager-1024.webp [L,R=301]
  RewriteRule ^assets/img/entretient-regulier\.jpg$ /assets/images/generated/entretien-jardin-arbore-1024.webp [L,R=301]
  RewriteRule ^assets/img/realisation-1\.png$ /assets/images/generated/tonte-pelouse-1024.webp [L,R=301]
  RewriteRule ^assets/img/realisation-2\.png$ /assets/images/generated/taille-haie-1024.webp [L,R=301]
  RewriteRule ^assets/img/realisation-pro\.jpg$ /assets/images/generated/finitions-chantier-paysagiste-1024.webp [L,R=301]
  RewriteRule ^assets/img/service-1\.png$ /assets/images/generated/creation-paysagere-1024.webp [L,R=301]
  RewriteRule ^assets/img/service-2\.jpg$ /assets/images/generated/jardin-arbore-apres-entretien-1024.webp [L,R=301]
  RewriteRule ^assets/img/service-3\.jpg$ /assets/images/generated/vegetaux-plantation-1024.webp [L,R=301]
  RewriteRule ^assets/img/aleixs_photo\.jpg$ /assets/images/generated/alexis-milliat-paysagiste-600.webp [L,R=301]
  RewriteRule ^(assets/img/favicon\.png|favicon\.ico)$ /assets/images/generated/favicon-48.png [L,R=301]
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/xml application/javascript application/json application/ld+json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json application/ld+json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # CSS et JS sont versionnés par ?v= à chaque build
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|svg|webmanifest)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Aucune ressource tierce ni script ou style inline : tout est servi depuis le domaine
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By
  # À activer une fois le HTTPS validé sur le domaine et le sous-domaine www
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
